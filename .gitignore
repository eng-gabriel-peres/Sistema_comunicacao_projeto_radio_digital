# Ambiente e caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Editores e sistema
.vscode/
.idea/
Thumbs.db
.DS_Store

# Dados de ensaio: capturas IQ e logs grandes ficam fora do git.
# O índice dos ensaios (dados/README.md) é versionado.
dados/*
!dados/README.md
# Registros de calibração são pequenos e são evidência de entrega (CAL-01):
# o JSON e a figura entram no git; a captura IQ (.npy) não.
!dados/calibracao/
dados/calibracao/*
!dados/calibracao/*.json
!dados/calibracao/*.png
# Logs de console e registros JSON dos ensaios: pequenos, são evidência.
!dados/logs/
dados/logs/*
!dados/logs/*.log
!dados/logs/*.json
*.npy
*.bin
*.iq
*.cu8
*.cf32

# Saídas geradas por scripts (figuras, relatórios temporários)
saidas/

# HTML intermediário do relatório (o PDF entra no git)
entregas/*.html
